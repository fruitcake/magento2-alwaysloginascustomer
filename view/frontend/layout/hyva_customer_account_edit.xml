<?xml version="1.0"?>
<!--
    Hyvä only: this handle is added by Hyva_Theme when a Hyvä theme is active.
    Hyvä renders the "Allow remote shopping assistance" checkbox on the account edit page
    in a block named form_additional_info_customer (Magento_LoginAsCustomerAssistance layout in the default theme).
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="form_additional_info_customer" remove="true"/>
    </body>
</page>
